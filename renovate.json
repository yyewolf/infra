{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/.*\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/.*\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Images pinned inside HelmRelease values, which no built-in manager reads. Annotate the line above the tag with `# renovate: datasource=docker depName=<image>`.",
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:tag|version):\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Full image references under an `imageName:` key, as CNPG's Cluster CR uses. The built-in kubernetes manager only reads `image:`, and the tag-only manager above cannot split a repository from its tag. Annotate the line above with `# renovate: datasource=docker`.",
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*imageName:\\s*[\"']?(?<depName>[^\"'\\s:]+):(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["flux/apps/uctf/**"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    },
    {
      "matchDepNames": ["immich", "woodpecker"],
      "pinDigests": false
    },
    {
      "matchCategories": [
        "docker"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "docker"
      ],
      "enabled": true,
      "groupName": "docker dependencies"
    }
  ]
}
